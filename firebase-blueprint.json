{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "userId": { "type": "string", "required": true },
        "shopName": { "type": "string", "required": true },
        "ownerName": { "type": "string", "required": false },
        "phone": { "type": "string", "required": false },
        "bkashNumber": { "type": "string", "required": false },
        "address": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "Product": {
      "collection": "users/{userId}/products",
      "fields": {
        "userId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "nameBn": { "type": "string", "required": false },
        "barcode": { "type": "string", "required": false },
        "purchasePrice": { "type": "number", "required": true },
        "sellingPrice": { "type": "number", "required": true },
        "stockQty": { "type": "number", "required": true },
        "unit": { "type": "string", "required": true },
        "lowStockThreshold": { "type": "number", "required": false },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "Contact": {
      "collection": "users/{userId}/contacts",
      "fields": {
        "userId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "phone": { "type": "string", "required": false },
        "type": { "type": "string", "required": true },
        "currentBalance": { "type": "number", "required": true },
        "address": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "Invoice": {
      "collection": "users/{userId}/invoices",
      "fields": {
        "userId": { "type": "string", "required": true },
        "invoiceNumber": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": false },
        "customerPhone": { "type": "string", "required": false },
        "items": { "type": "list", "required": true },
        "subtotal": { "type": "number", "required": true },
        "discount": { "type": "number", "required": false },
        "tax": { "type": "number", "required": false },
        "totalAmount": { "type": "number", "required": true },
        "paidAmount": { "type": "number", "required": true },
        "dueAmount": { "type": "number", "required": true },
        "paymentMode": { "type": "string", "required": true },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "LedgerEntry": {
      "collection": "users/{userId}/ledger",
      "fields": {
        "userId": { "type": "string", "required": true },
        "contactId": { "type": "string", "required": true },
        "contactName": { "type": "string", "required": false },
        "type": { "type": "string", "required": true },
        "amount": { "type": "number", "required": true },
        "note": { "type": "string", "required": false },
        "invoiceId": { "type": "string", "required": false },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "VoiceShortcut": {
      "collection": "users/{userId}/shortcuts",
      "fields": {
        "userId": { "type": "string", "required": true },
        "triggerWord": { "type": "string", "required": true },
        "targetProductName": { "type": "string", "required": true },
        "defaultQuantity": { "type": "number", "required": true },
        "defaultPrice": { "type": "number", "required": true },
        "createdAt": { "type": "timestamp", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    }
  }
}
